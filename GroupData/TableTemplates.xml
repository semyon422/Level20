	<Button name="Level20GroupDataRowTemplate" mixin="Level20GroupDataRowMixin" virtual="true">
		<Size x="0" y="20"/>
		<Anchors>
			<Anchor point="LEFT"/>
			<Anchor point="RIGHT"/>
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="SelectedHighlight" atlas="auctionhouse-ui-row-select" alphaMode="ADD" hidden="true"/>
				<Texture parentKey="HighlightTexture" atlas="auctionhouse-ui-row-highlight" alphaMode="ADD" setAllPoints="true" hidden="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
		<NormalTexture parentKey="NormalTexture" atlas="auctionhouse-rowstripe-1" setAllPoints="true"/>
	</Button>

	<Frame name="Level20GroupDataCellTemplate" mixin="Level20GroupDataCellMixin" virtual="true">
		<Size x="0" y="16"/>
		<Layers>
			<Layer level="BACKGROUND">
				<FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT" maxLines="1" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="Level20GroupDataIconCellTemplate" mixin="Level20GroupDataIconCellMixin" virtual="true">
		<Size x="0" y="16"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Icon" hidden="true">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="Level20GroupDataBooleanCellTemplate" mixin="Level20GroupDataBooleanCellMixin" virtual="true">
		<Size x="0" y="16"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Icon" hidden="true">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
				<FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyH="CENTER" maxLines="1" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>

	<Button name="Level20GroupDataHeaderTemplate" mixin="Level20GroupDataHeaderMixin" inherits="ColumnDisplayButtonShortTemplate" virtual="true">
		<Size x="0" y="19"/>
	</Button>
